.

# Construct: ISO 19107-2003 - Spatial schema::GM_MultiSurface (PRIMITIEF DATATYPE)
<http://definities.geostandaarden.nl/iso-19107-datatypen/id/concept/GM_MultiSurface>
   a skos:Concept ;
   skos:prefLabel "GM_MultiSurface"@nl ;
   dct:created "2024-02-16"^^xsd:date ;
   dct:modified "2025-09-02"^^xsd:date ;
   skos:inScheme <http://definities.geostandaarden.nl/iso-19107-datatypen/id/conceptscheme/ISO%2019107-2003> ;
   skos:broader <http://definities.geostandaarden.nl/iso-19107-datatypen/id/concept/GM_MultiPrimitive> ;
   skos:definition "Multivlak. Verzameling van vlakken die gezamenlijk één object vormen (instanties van GM_Surface)."@nl ;
   skos:scopeNote "Vlakken in een multisurface mogen elkaar niet overlappen. In een simple multisurface mogen vlakken elkaar alleen raken in een eindig aantal punten (wel punten maar geen grenzen gemeenschappelijk)\nZie verder: https://docs.geostandaarden.nl/nen3610/gimeg/#gm_multisurface."@nl ;
   dct:source "ISO 19107-2003" ;
.

